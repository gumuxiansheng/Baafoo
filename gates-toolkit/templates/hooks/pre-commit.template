#!/bin/sh
# Generated by gates-toolkit (do not edit manually; re-run setup-gates to regenerate)
# pre-commit hook — 代码门禁（自动跳过无 SQL/Java 改动）
# 安装说明见 gates-toolkit/README.md

set -e

PROJECT_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
TOOLS_DIR="$PROJECT_ROOT/gates-tools"

# 快速跳过：没有 staged 改动时不跑门禁
CHANGED="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"
if [ -z "$CHANGED" ]; then
  echo "[pre-commit] no staged changes, skipping gate"
  exit 0
fi

# ---- staleness 检测：gates-toolkit 指纹与 setup 时记录的 .meta 比对（只提示，不阻断）----
# 指纹 = SHA256( versions.toml + 按 C 序排列的(":"+相对路径+":"+文件内容)[templates/** + bin/**/rules/**] )
# 不一致 → toolkit 有更新（如成员 git pull 拉到新版），提示重跑 setup 刷新门禁/规则/二进制。
# 算法必须与 scripts/setup-gates.sh 的 gates_toolkit_fingerprint 保持一致。
gates_toolkit_fingerprint() {
  (
    cd "$1" 2>/dev/null || exit 0
    if command -v sha256sum >/dev/null 2>&1; then H="sha256sum"; else H="shasum -a 256"; fi
    {
      cat versions.toml 2>/dev/null
      { find templates -type f 2>/dev/null; find bin -type f -path '*/rules/*' 2>/dev/null; } \
        | LC_ALL=C sort | while IFS= read -r f; do
            printf ':%s:' "$f"
            cat "$f" 2>/dev/null
          done
    } | $H | awk '{print $1}'
  )
}

if [ -d "$PROJECT_ROOT/gates-toolkit" ] && [ -f "$TOOLS_DIR/.meta" ]; then
  _meta_fp="$(sed -n 's/^toolkit_fingerprint=//p' "$TOOLS_DIR/.meta" 2>/dev/null | tr -d '[:space:]')"
  if [ -n "$_meta_fp" ]; then
    _cur_fp="$(gates_toolkit_fingerprint "$PROJECT_ROOT/gates-toolkit")"
    if [ -n "$_cur_fp" ] && [ "$_cur_fp" != "$_meta_fp" ]; then
      echo ""
      echo "[gates] gates-toolkit 已更新（本地 gates-tools 由旧版工具集生成），本次提交仍使用旧门禁。"
      echo "[gates] 请重跑 setup 刷新门禁/规则/二进制："
      echo "[gates]   Windows: gates-toolkit\\scripts\\setup-gates.cmd"
      echo "[gates]   Linux:   bash gates-toolkit/scripts/setup-gates.sh"
      echo ""
    fi
  fi
fi

# 智能跳过：仅当涉及 SQL/Mapper/Java 时才触发门禁
# （xml 放宽到全部 *.xml：非 Mapper XML 由后续检查按 "mapper" 路径特征再过滤，
#   避免遗漏 MapperViolation_xxx.xml 这类不以 Mapper.xml 结尾的命名）
NEED_SQL=false
NEED_JAVA=false
for f in $CHANGED; do
  case "$f" in
    *.sql|*.ddl|*.dml|*.xml) NEED_SQL=true ;;
    *.java) NEED_JAVA=true ;;
  esac
done

if [ "$NEED_SQL" = false ] && [ "$NEED_JAVA" = false ]; then
  echo "[pre-commit] changes do not involve SQL/Java, skipping gate"
  exit 0
fi

export JAVAGUARD_PARSER_JAR="$TOOLS_DIR/java-guard/java-parser/java-parser.jar"

# 优先用 wan 编排（传 -C 让 wan 以项目根为工作目录，workflow 内用相对路径）
WAN_BIN="$TOOLS_DIR/wan/bin/wan"
if [ ! -x "$WAN_BIN" ] && [ -x "$WAN_BIN.exe" ]; then
  WAN_BIN="$WAN_BIN.exe"
fi
if [ -x "$WAN_BIN" ]; then
  # Windows 用 pwsh workflow，Linux/macOS 用 bash workflow
  WORKFLOW_FILE="$TOOLS_DIR/wan/workflows/pre-commit-unix.yml"
  if [ -f "$TOOLS_DIR/wan/workflows/pre-commit-win.yml" ] && command -v pwsh >/dev/null 2>&1; then
    WORKFLOW_FILE="$TOOLS_DIR/wan/workflows/pre-commit-win.yml"
  fi
  if [ -f "$WORKFLOW_FILE" ]; then
    # 捕获 wan 全部输出：失败时先向 stderr 输出一行错误摘要，再回放完整明细。
    # IDE（VSCode/IntelliJ）提交失败弹窗展示的是 git 的 stderr（通常只显示首行），
    # 若直接透传，弹窗首行会是检查横幅而不是错误信息；终端里看到的内容不变。
    GATE_RC=0
    GATE_OUTPUT="$("$WAN_BIN" run -C "$PROJECT_ROOT" "$WORKFLOW_FILE" 2>&1)" || GATE_RC=$?
    # 剥离 ANSI 颜色码：wan 在管道下仍输出颜色，IDE 弹窗/输出面板会把 ESC 序列
    # 显示成 [1m[36m 之类的乱码（先捕获再剥离，保留 wan 退出码）。
    GATE_OUTPUT="$(printf '%s\n' "$GATE_OUTPUT" | sed "s/$(printf '\033')\\[[0-9;]*[mK]//g")"
    if [ "$GATE_RC" -ne 0 ]; then
      echo "✗ 代码门禁未通过，提交已被阻止（违规明细如下）" >&2
      printf '%s\n' "$GATE_OUTPUT" >&2
      echo "" >&2
      echo "修复违规后重新提交；确认跳过本次门禁: git commit --no-verify" >&2
      exit "$GATE_RC"
    fi
    printf '%s\n' "$GATE_OUTPUT"
    exit 0
  fi
fi

# fallback: 直接调用工具（wan 缺失时）
# SqlGuard 增量检查（需 sqlguard >= 0.2.2）：check-diff 的 diff 终点是工作区，
# staged/unstaged/untracked 改动全覆盖，pre-commit 场景直接用 --base HEAD。
# 从项目根运行（git diff 按 CWD 输出文件路径）。
echo ""
echo "=== SqlGuard Check (incremental) ==="
SG_BIN="$TOOLS_DIR/sql-guard/bin/sqlguard"
if [ -f "$SG_BIN.exe" ]; then SG_BIN="$SG_BIN.exe"; fi
( cd "$PROJECT_ROOT" && "$SG_BIN" check-diff --base HEAD \
    -c "$TOOLS_DIR/sql-guard/sqlguard.toml" -f plain . ) || {
  echo "✗ SqlGuard 门禁未通过，提交已被阻止。修复后重试；确认跳过: git commit --no-verify" >&2
  exit 1
}
echo "✓ SqlGuard passed"

{{FALLBACK_JAVA_BLOCK}}

echo ""
echo "✓ All gate checks passed"
echo ""
exit 0
